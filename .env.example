# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medibridge
DB_USER=root
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting
# Global limiter — applies to all API requests from a single IP.
# Development default: 500 (generous for manual testing across all 6 roles).
# Production recommendation: 100 or lower.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Login-specific limiter — separate, tighter limit on POST /auth/login only.
# Development default: 60 (allows testing all 6 roles sequentially, ~10 logins each).
# Production recommendation: 10 or lower.
LOGIN_RATE_LIMIT_MAX_REQUESTS=60

# Appointment reminders
APPOINTMENT_REMINDER_LEAD_MINUTES=60
APPOINTMENT_REMINDER_INTERVAL_MS=300000
